+test("wheel over the visible preview scrolls the preview pane", () => {
+	const preview = Array.from({ length: 24 }, (_, index) =>
+		`Preview-${String(index).padStart(2, "0")} ${"x".repeat(36)}`,
+	).join(" ");
+	const view = new QuestionnaireView({
+		questions: [question("Choose?", [option("Alpha", "First choice", preview)])],
+		theme,
+		tui: { terminal: { rows: 12 }, requestRender() {} } as TUI,
+	});
+	const lines = view.render(100);
+	const point = renderedPoint(lines, "Preview-00");
+	const bodyPoint = renderedPoint(lines, "Alpha");
+	assert.ok(point.x > bodyPoint.x, "preview coordinates must be right of the rendered body");
+	const result = view.handleMouse(wheelEvent(lines, point.x, point.y, "down"));
+	assert.equal(result?.handled, true);
+	const after = plain(render(view));
+	assert.doesNotMatch(after, /Preview-00/);
+	assert.match(after, /Preview-01/);
+});
+
+test("wheel over the questionnaire body scrolls the body pane", () => {
+	const preview = "Body-preview-anchor";
+	const options = Array.from({ length: 12 }, (_, index) =>
+		option(`Body-${String(index).padStart(2, "0")}`, "Body description ".repeat(4), index === 0 ? preview : undefined),
+	);
+	const view = new QuestionnaireView({
+		questions: [question("Choose a body row?", options)],
+		theme,
+		tui: { terminal: { rows: 10 }, requestRender() {} } as TUI,
+	});
+	const lines = view.render(100);
+	const point = renderedPoint(lines, "Body-00");
+	const previewStart = renderedPoint(lines, preview).x;
+	assert.ok(point.x < previewStart, "body coordinates must be left of the rendered preview");
+	const beforeBody = lines.map((line) => plain(line).slice(0, previewStart));
+	const result = view.handleMouse(wheelEvent(lines, point.x, point.y, "down"));
+	assert.equal(result?.handled, true);
+	const afterLines = view.render(100);
+	assert.notDeepEqual(afterLines.map((line) => plain(line).slice(0, previewStart)), beforeBody);
+	assert.match(plain(afterLines.join("\n")), /Body-preview-anchor/);
+});
