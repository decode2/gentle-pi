+function renderedPoint(lines: string[], text: string): { x: number; y: number } {
+	const y = lines.findIndex((line) => plain(line).includes(text));
+	assert.ok(y >= 0, `rendered geometry does not contain ${text}`);
+	const line = plain(lines[y]!);
+	const index = line.indexOf(text);
+	assert.ok(index >= 0);
+	return { x: visibleWidth(line.slice(0, index)), y };
+}
+
+function wheelEvent(
+	lines: string[],
+	x: number,
+	y: number,
+	direction: "up" | "down",
+	width = 100,
+): TuiMouseEvent {
+	return {
+		type: "wheel",
+		button: "none",
+		wheelDelta: direction === "down" ? 1 : -1,
+		x,
+		y,
+		screenX: x,
+		screenY: y,
+		width,
+		height: lines.length,
+		shift: false,
+		alt: false,
+		ctrl: false,
+	};
+}
+
