+test("unclaimed wheel input falls through without claiming transcript scrolling", () => {
+	const { view } = viewWithResult(single());
+	const lines = view.render(100);
+	const y = renderedPoint(lines, "Header").y;
+	const x = 99;
+	assert.equal(plain(lines[y]!).slice(x).trim(), "", "the point must be in rendered blank space");
+	assert.equal(view.handleMouse(wheelEvent(lines, x, y, "down")), undefined);
+	assert.equal(view.activeQuestion, 0);
+	assert.deepEqual(view.getResult().answers, []);
+});
