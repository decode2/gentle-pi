+test("mouse coordinates from before a terminal resize are rejected", () => {
+	const terminal = { rows: 12, columns: 100 };
+	const view = new QuestionnaireView({
+		questions: [question("A deliberately long question that wraps at twenty", [
+			option("Alpha"), option("Beta"), option("Gamma"),
+		])],
+		theme,
+		tui: { terminal, requestRender() {} } as TUI,
+	});
+	const before = view.render(terminal.columns);
+	const point = renderedPoint(before, "Gamma");
+	const stale = {
+		...mouseEvent(before, point.y, "click"),
+		x: point.x,
+		screenX: point.x,
+		width: terminal.columns,
+		height: before.length,
+	};
+	terminal.rows = 10;
+	terminal.columns = 20;
+	view.render(terminal.columns);
+	assert.equal(view.handleMouse(stale), undefined);
+	assert.deepEqual(view.getResult().answers, []);
+});
