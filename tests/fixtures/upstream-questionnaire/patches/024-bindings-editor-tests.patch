+function withInstalledKeybindings(
+	userBindings: KeybindingsConfig,
+	exercise: (keybindings: KeybindingsManager) => void,
+): void {
+	const previous = getKeybindings();
+	const keybindings = new KeybindingsManager(TUI_KEYBINDINGS, userBindings);
+	try {
+		setKeybindings(keybindings);
+		assert.strictEqual(getKeybindings(), keybindings);
+		exercise(keybindings);
+	} finally {
+		setKeybindings(previous);
+	}
+	assert.strictEqual(getKeybindings(), previous);
 }
 
