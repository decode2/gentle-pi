+test("configured select bindings remap navigation and explicit disabled arrays do not fall back", () => {
+	const remapped = new KeybindingsManager(TUI_KEYBINDINGS, {
+		"tui.select.down": "ctrl+n",
+		"tui.select.confirm": "ctrl+y",
+	});
+	const { view, completed } = viewWithResult(single(), remapped);
+	view.handleInput(KEY.down[0]);
+	assert.match(render(view), /❯ Alpha/);
+	view.handleInput("\x0e");
+	assert.match(render(view), /❯ Beta/);
+	view.handleInput(KEY.enter);
+	assert.deepEqual(view.getResult().answers, []);
+	view.handleInput("\x19");
+	moveCursorTo(view, "Submit", "\x0e");
+	view.handleInput("\x19");
+	assert.equal(completed[0]?.answers[0]?.answer, "Beta");
+
+	const disabled = viewWithResult(single(), new KeybindingsManager(TUI_KEYBINDINGS, {
+		"tui.select.down": [],
+	}));
+	disabled.view.handleInput(KEY.down[0]);
+	assert.match(render(disabled.view), /❯ Alpha/);
+});
+
+test("default editor keys create multiline custom text and visible Submit commits the preserved draft", () => {
+	withInstalledKeybindings({}, (keybindings) => {
+		const { view, completed } = viewWithResult(single(), keybindings);
+		view.handleInput(KEY.down[0]);
+		view.handleInput(KEY.down[0]);
+		view.handleInput(KEY.enter);
+		view.handleInput("alpha");
+		view.handleInput(KEY.enter);
+		view.handleInput("beta");
+		view.handleInput("\x1b[13;2~");
+		view.handleInput("gamma");
+		view.handleInput("\x0a");
+		view.handleInput("delta");
+		assert.match(plain(render(view)), /alpha[\s\S]*beta[\s\S]*gamma[\s\S]*delta/);
+		view.handleInput(KEY.escape);
+		moveCursorTo(view, "Submit");
+		view.handleInput(KEY.enter);
+		assert.deepEqual(completed, [{
+			cancelled: false,
+			answers: [{
+				questionIndex: 0,
+				question: "Proceed?",
+				kind: "custom",
+				answer: "alpha\nbeta\ngamma\ndelta",
+			}],
+		}]);
+	});
+});
+
+test("remapped newline submit and tab bindings preserve a multiline draft across questions", () => {
+	withInstalledKeybindings({
+		"tui.input.newLine": "ctrl+n",
+		"tui.input.submit": "ctrl+s",
+		"tui.input.tab": "ctrl+t",
+	}, (keybindings) => {
+		const { view } = viewWithResult(two(), keybindings);
+		view.handleInput(KEY.down[0]);
+		view.handleInput(KEY.down[0]);
+		view.handleInput(KEY.enter);
+		view.handleInput("first");
+		view.handleInput("\x0e");
+		view.handleInput("second");
+		view.handleInput("\x14");
+		assert.equal(view.activeQuestion, 1);
+		view.handleInput(KEY.shiftTab);
+		view.handleInput(KEY.enter);
+		assert.match(plain(render(view)), /first[\s\S]*second/);
+		view.handleInput("\x13");
+		assert.deepEqual(view.getResult().answers, [{
+			questionIndex: 0,
+			question: "First?",
+			kind: "custom",
+			answer: "first\nsecond",
+		}]);
+	});
+});
+
