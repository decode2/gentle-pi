+test("ask_user_question closes before a deferred custom factory can mount a dock", async () => {
+	const { tool, emitted } = registerQuestionTool();
+	const controller = new AbortController();
+	const observed = instrumentAbortSignal(controller.signal);
+	let component: Renderable | undefined;
+	let releaseMount: (() => void) | undefined;
+	let resolveHost: ((value: unknown) => void) | undefined;
+	let closed = false;
+	let mounted = false;
+	let mountCalls = 0;
+	let doneCalls = 0;
+	const doneSources: string[] = [];
+	let cleanup = false;
+	const pending = tool.execute(
+		"abort-deferred",
+		{ questions: single() },
+		controller.signal,
+		undefined,
+		{
+			mode: "tui",
+			ui: {
+				custom: async (factory: CustomFactory) => new Promise<unknown>((resolve) => {
+					resolveHost = (value) => {
+						if (closed) return;
+						closed = true;
+						resolve(value);
+					};
+					const produced = factory({ requestRender() {} }, theme, {}, (value) => {
+						doneCalls++;
+						doneSources.push(cleanup ? "cleanup" : "producer");
+						resolveHost?.(value);
+					});
+					component = produced;
+					const deferred = new Promise<Renderable>((resolveDeferred) => {
+						releaseMount = () => resolveDeferred(produced);
+					});
+					deferred.then(() => {
+						if (closed) return;
+						mounted = true;
+						mountCalls++;
+					});
+				}),
+			},
+		},
+	);
+	controller.abort();
+	releaseMount?.();
+	const settled = await settleAfterAbort(pending, () => {
+		cleanup = true;
+		component?.handleInput?.("\x1b");
+		resolveHost?.({ cancelled: true, answers: [] });
+	});
+	observed.restore();
+
+	assert.deepEqual(
+		{
+			fallback: settled.fallback,
+			value: settled.value,
+			doneCalls,
+			doneSources,
+			closed,
+			mounted,
+			mountCalls,
+			listeners: observed.counts(),
+			emitted,
+		},
+		{
+			fallback: false,
+			value: {
+				content: [{ type: "text", text: "User cancelled the questionnaire" }],
+				details: { cancelled: true },
+			},
+			doneCalls: 1,
+			doneSources: ["producer"],
+			closed: true,
+			mounted: false,
+			mountCalls: 0,
+			listeners: { added: 1, removed: 1 },
+			emitted: [
+				{ channel: "gentle-pi:ask-user-question:blocked", data: { active: true } },
+				{ channel: "rpiv:ask-user:blocked", data: { active: true } },
+				{ channel: "gentle-pi:ask-user-question:blocked", data: { active: false } },
+				{ channel: "rpiv:ask-user:blocked", data: { active: false } },
+			],
+		},
+	);
+});
