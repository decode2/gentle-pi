+test("ask_user_question aborts a mounted questionnaire with committed partial answers", async () => {
+	const subject = startAbort("abort-mounted");
+	assert.ok(subject.mounted.state.component);
+	subject.mounted.state.component!.handleInput?.("\r");
+	subject.controller.abort();
+	const observed = await settleAfterAbort(subject.pending, subject.mounted.cancel);
+	subject.observed.restore();
+	assert.deepEqual(
+		[observed.fallback, subject.mounted.state.doneCalls, subject.observed.counts()],
+		[false, 1, { added: 1, removed: 1 }],
+	);
+	assert.deepEqual(observed.value, {
+		content: [{ type: "text", text: "User cancelled the questionnaire\nPartial answers:\n1. First? — Alpha" }],
+		details: { cancelled: true, answers: committedFirst },
+	});
+	assertAbortLifecycle(subject.emitted);
+});
+
+async function finishAbort(subject: ReturnType<typeof startAbort>) {
+	const settled = await settleAfterAbort(subject.pending, subject.mounted.cancel);
+	subject.observed.restore();
+	return {
+		...settled,
+		doneCalls: subject.mounted.state.doneCalls,
+		emitted: subject.emitted,
+		listeners: subject.observed.counts(),
+	};
+}
