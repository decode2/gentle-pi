+function instrumentAbortSignal(signal: AbortSignal) {
+	let added = 0;
+	let removed = 0;
+	const add = signal.addEventListener;
+	const remove = signal.removeEventListener;
+	signal.addEventListener = ((
+		type: string,
+		listener: EventListenerOrEventListenerObject | null,
+		options?: boolean | AddEventListenerOptions,
+	) => {
+		if (listener === null) return;
+		if (type === "abort") added++;
+		return add.call(signal, type, listener, options);
+	}) as typeof signal.addEventListener;
+	signal.removeEventListener = ((
+		type: string,
+		listener: EventListenerOrEventListenerObject | null,
+		options?: boolean | EventListenerOptions,
+	) => {
+		if (listener === null) return;
+		if (type === "abort") removed++;
+		return remove.call(signal, type, listener, options);
+	}) as typeof signal.removeEventListener;
+	return {
+		counts: () => ({ added, removed }),
+		restore: () => {
+			signal.addEventListener = add;
+			signal.removeEventListener = remove;
+		},
+	};
+}
+
+function pendingCustom() {
+	const state = {
+		component: undefined as Renderable | undefined,
+		doneCalls: 0,
+		resolve: undefined as ((value: unknown) => void) | undefined,
+	};
+	const custom = async (factory: CustomFactory) => new Promise<unknown>((resolve) => {
+		state.resolve = (value) => {
+			resolve(value);
+		};
+		state.component = factory({ requestRender() {} }, theme, {}, (value) => {
+			state.doneCalls++;
+			state.resolve?.(value);
+		});
+	});
+	const cancel = () => {
+		state.component?.handleInput?.("\x1b");
+		state.component?.handleInput?.("\x1b");
+		state.resolve?.({ cancelled: true, answers: [] });
+	};
+	return { state, custom, cancel };
+}
+
+function assertAbortLifecycle(emitted: readonly LifecycleEvent[]) {
+	assert.deepEqual(emitted, [
+		{ channel: "gentle-pi:ask-user-question:blocked", data: { active: true } },
+		{ channel: "rpiv:ask-user:blocked", data: { active: true } },
+		{ channel: "gentle-pi:ask-user-question:blocked", data: { active: false } },
+		{ channel: "rpiv:ask-user:blocked", data: { active: false } },
+	]);
+}
+
+async function settleAfterAbort<T>(pending: Promise<T>, cleanup: () => void) {
+	let settled = false;
+	pending.then(
+		() => { settled = true; },
+		() => { settled = true; },
+	);
+	for (let turn = 0; turn < 4 && !settled; turn++) {
+		await Promise.resolve();
+	}
+	const fallback = !settled;
+	if (fallback) cleanup();
+	return { value: await pending, fallback };
+}
