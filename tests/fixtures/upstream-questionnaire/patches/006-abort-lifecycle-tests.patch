+test("ask_user_question removes abort listeners while preserving a custom UI rejection", async () => {
+	const { tool, emitted } = registerQuestionTool();
+	const controller = new AbortController();
+	const observed = instrumentAbortSignal(controller.signal);
+	const failure = new Error("custom UI failed");
+	let customCalls = 0;
+	let doneCalls = 0;
+
+	await assert.rejects(
+		() => tool.execute(
+			"abort-rejection",
+			{ questions: single() },
+			controller.signal,
+			undefined,
+			{
+				mode: "tui",
+				ui: {
+					custom: async (factory: CustomFactory) => {
+						customCalls++;
+						factory({ requestRender() {} }, theme, {}, () => {
+							doneCalls++;
+						});
+						throw failure;
+					},
+				},
+			},
+		),
+		(error: unknown) => error === failure,
+	);
+	controller.abort();
+	await Promise.resolve();
+	observed.restore();
+
+	assert.deepEqual(
+		[customCalls, doneCalls, emitted, observed.counts()],
+		[1, 0, [
+			{ channel: "gentle-pi:ask-user-question:blocked", data: { active: true } },
+			{ channel: "rpiv:ask-user:blocked", data: { active: true } },
+			{ channel: "gentle-pi:ask-user-question:blocked", data: { active: false } },
+			{ channel: "rpiv:ask-user:blocked", data: { active: false } },
+		], { added: 1, removed: 1 }],
+	);
+});
