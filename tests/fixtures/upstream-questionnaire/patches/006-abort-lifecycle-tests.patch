+test("ask_user_question returns empty cancellation before mounting an already-aborted request", async () => {
+	const { tool, emitted } = registerQuestionTool();
+	const controller = new AbortController();
+	controller.abort();
+	const observed = instrumentAbortSignal(controller.signal);
+	let customCalls = 0;
+	let doneCalls = 0;
+	const result = await tool.execute(
+		"abort-pre",
+		{ questions: single() },
+		controller.signal,
+		undefined,
+		{
+			mode: "tui",
+			ui: {
+				custom: async (factory: CustomFactory) => {
+					customCalls++;
+					let value: unknown;
+					const component = factory({ requestRender() {} }, theme, {}, (next) => {
+						doneCalls++;
+						value = next;
+					});
+					component.handleInput?.("\x1b");
+					return value;
+				},
+			},
+		},
+	);
+	observed.restore();
+	assert.deepEqual(
+		[customCalls, doneCalls, emitted, observed.counts()],
+		[0, 0, [], { added: 0, removed: 0 }],
+	);
+	assert.deepEqual(result, {
+		content: [{ type: "text", text: "User cancelled the questionnaire" }],
+		details: { cancelled: true },
+	});
+});
