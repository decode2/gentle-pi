+test("ask_user_question RPC input-only multiSelect retyping replaces the saved custom draft", async () => {
+	const { tool, emitted } = registerQuestionTool();
+	const choices = ["Toggle an option", "Two", "Use custom text", "Use custom text", "Submit"];
+	const inputs = ["first draft", "revised draft"];
+	const inputArgs: Array<[string, string | undefined]> = [];
+	let customCalls = 0;
+	const result = await run(tool, {
+		questions: [{ question: "Pick?", header: "Pick", options: [option("One"), option("Two")], multiSelect: true }],
+	}, {
+		mode: "rpc", hasUI: true,
+		ui: {
+			custom: async () => { customCalls++; return undefined; },
+			select: async (_title: string, options: string[]) => {
+				const choice = choices.shift();
+				assert.ok(choice && options.includes(choice), `RPC dialog must expose ${choice}`);
+				return choice;
+			},
+			input: async (title: string, placeholder?: string) => {
+				inputArgs.push([title, placeholder]);
+				return inputs.shift();
+			},
+		},
+	});
+
+	assert.deepEqual(result.details, {
+		answers: [{ questionIndex: 0, question: "Pick?", kind: "custom", answer: "revised draft", selected: ["Two"] }],
+	});
+	assert.equal(result.content[0]?.text, "1. Pick? — (custom) revised draft — selected: Two");
+	assert.deepEqual(choices, []);
+	assert.deepEqual(inputs, []);
+	assert.equal(customCalls, 0, "RPC must not mount ctx.ui.custom");
+	assertAbortLifecycle(emitted);
+	assert.deepEqual(inputArgs, [["Pick?", undefined], ["Pick?", "first draft"]], "second input visit must show the saved draft as placeholder");
+});
+
